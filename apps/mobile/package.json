{
  "name": "mogumogu-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first EXPO_NO_TELEMETRY=1 expo start --ios --localhost --port 8081 --clear",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~56.0.13",
    "expo-auth-session": "~56.0.14",
    "expo-build-properties": "~56.0.20",
    "expo-dev-client": "~56.0.21",
    "expo-image-picker": "~56.0.19",
    "expo-location": "~56.0.19",
    "expo-notifications": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "jest": "^30.4.2",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
