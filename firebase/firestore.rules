rules_version = '2';

// ⚠️ POC 규칙: 참여/정산/후기를 클라이언트가 직접 쓰도록 일부 완화함.
//    실서비스 전환 시 Cloud Functions 경유로 다시 조일 것
//    (gonggus update / participations / settlements / reviews).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /userPrivate/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /gonggus/{gongguId} {
      allow read: if signedIn();
      allow create: if signedIn();
      // POC: 참여 시 인원/상태 갱신을 클라이언트가 직접 수행
      allow update: if signedIn();
      allow delete: if false;

      // 참여 내역은 top-level `participations` 컬렉션으로 통일됨(하단 참고).
      // 예전 gonggus/{id}/participants 서브컬렉션은 미사용이라 제거함.

      match /images/{imageId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      // POC: 후기 작성을 클라이언트가 직접 수행
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /settlements/{settlementId} {
      allow read: if signedIn();
      // POC: 정산 숫자 계산/상태 전환을 클라이언트가 직접 수행
      allow write: if signedIn();
    }

    match /participations/{participationId} {
      // POC: 참여 내역을 클라이언트가 직접 읽고 씀
      allow read, write: if signedIn();
    }

    match /payments/{paymentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /notifications/{userId} {
      match /items/{itemId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if signedIn();
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /userStats/{userId} {
      // POC: 노쇼 신고 시 신고자가 대상 유저의 집계 카운트를 직접 갱신
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

